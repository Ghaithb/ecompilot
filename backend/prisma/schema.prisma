// Orders System SaaS — PostgreSQL multi-tenant (Prisma)
// MongoDB reste utilisé pour auth, produits legacy, delivery shipments.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id               String   @id @default(cuid())
  tenantId         String
  orderNumber      String
  customerEmail    String
  status           String   @default("created")
  paymentStatus    String   @default("pending")
  paymentMethod    String   @default("cod")
  subtotal         Decimal  @db.Decimal(12, 3)
  taxAmount        Decimal  @default(0) @db.Decimal(12, 3)
  shippingAmount   Decimal  @default(0) @db.Decimal(12, 3)
  discountAmount   Decimal  @default(0) @db.Decimal(12, 3)
  total            Decimal  @db.Decimal(12, 3)
  currency         String   @default("TND")

  /// Lien vers expédition (MongoDB Shipment._id ou référence externe)
  shipmentId       String?
  trackingNumber   String?
  shippingProvider String?

  shippingAddress  Json?
  metadata         Json?

  lineItems     OrderLineItem[]
  statusEvents  OrderStatusEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, shipmentId])
  @@map("orders")
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  firstName String
  lastName  String
  phone     String?
  status    String   @default("active")
  tags      String[] @default([])
  stats     Json?
  mongoId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId, phone])
  @@map("customers")
}

model Shipment {
  id             String   @id @default(cuid())
  tenantId       String
  mongoOrderId   String?
  orderNumber    String?
  provider       String
  trackingNumber String
  status         String   @default("created")
  mock           Boolean  @default(false)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, trackingNumber])
  @@index([tenantId, status])
  @@map("shipments")
}

model OrderLineItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  title     String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 3)
  total     Decimal @db.Decimal(12, 3)

  @@index([orderId])
  @@map("order_line_items")
}

model OrderStatusEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  changedBy  String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt(sort: Desc)])
  @@map("order_status_events")
}
