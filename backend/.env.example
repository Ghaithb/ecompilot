# Configuration du serveur
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Base de données MongoDB
MONGODB_URI=mongodb://localhost:27017/ecompilot
MONGODB_TEST_URI=mongodb://localhost:27017/ecompilot_test

# PostgreSQL — Orders System SaaS (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecompilot_orders?schema=public
# Dual-write Mongo → Postgres (orders, customers, shipments)
ORDERS_DUAL_WRITE=false
# Enable PostgreSQL RLS tenant policies (requires enable-rls.sql)
PRISMA_RLS_ENABLED=false

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-and-make-it-longer-than-32-characters
JWT_EXPIRES_IN=7d

# CORS Configuration  
CORS_ORIGIN=http://localhost:5173,http://localhost:3002

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# OpenAI Configuration (optionnel en développement)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini Configuration (GRATUIT - Recommandé)
GEMINI_API_KEY=AIzaSyBtf8e2dHJL6XwmgIVmz3JrWEv8p8RflhM

# Stripe Configuration (optionnel en développement)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Redis Configuration (optionnel)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rasa Configuration
RASA_SERVER_URL=http://localhost:5005
RASA_ACTIONS_URL=http://localhost:5055
ENABLE_RASA_SIMULATION=true

# ── Messaging startup stack (Meta / Twilio / Resend) ──

# Meta WhatsApp Cloud API
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_BUSINESS_NUMBER=21600000000
META_WHATSAPP_TEMPLATE_LANG=fr
META_WHATSAPP_VERIFY_TOKEN=ecompilot_verify

# Twilio SMS OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Resend Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=EcomPilot <onboarding@resend.dev>

# Upstash Redis (optional — BullMQ / OTP TTL)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudinary (optional — image CDN)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=