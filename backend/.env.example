# APP CONFIG
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3001

# DATABASE (MongoDB only - Mongoose)
MONGODB_URI=mongodb://localhost:27017/ecompilot

# SECURITY
JWT_SECRET=super-secret-key-change-me
JWT_EXPIRES_IN=24h

# WHATSAPP (Meta Cloud API / WAHA)
WHATSAPP_PROVIDER=meta
WHATSAPP_BUSINESS_NUMBER=216XXXXXXXX
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_WAHA_URL=http://localhost:3000

# AI (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key

# STORAGE
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# REDIS (For abandoned cart recovery & reminders)
REDIS_HOST=localhost
REDIS_PORT=6379