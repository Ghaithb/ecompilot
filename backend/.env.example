# APP CONFIG
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3001

# DATABASE (MongoDB only - Mongoose)
MONGODB_URI=mongodb://localhost:27017/ecompilot

# SECURITY
JWT_SECRET=super-secret-key-change-me
JWT_EXPIRES_IN=24h

# WHATSAPP (Hybrid Provider — Meta Cloud API or self-hosted WAHA)
# Set WHATSAPP_PROVIDER=meta for official Meta API, or WHATSAPP_PROVIDER=waha for self-hosted
WHATSAPP_PROVIDER=meta
WHATSAPP_BUSINESS_NUMBER=216XXXXXXXX

# Meta Cloud API (needed when WHATSAPP_PROVIDER=meta)
META_WHATSAPP_TOKEN=your-meta-access-token
META_WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
META_WHATSAPP_VERIFY_TOKEN=ecompilot_verify
META_WHATSAPP_TEMPLATE_LANG=fr

# WAHA Self-Hosted (needed when WHATSAPP_PROVIDER=waha)
WHATSAPP_WAHA_URL=http://localhost:3000
WHATSAPP_WAHA_TOKEN=your-waha-api-token

# AI (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key

# STORAGE
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# REDIS (For abandoned cart recovery & reminders)
REDIS_HOST=localhost
REDIS_PORT=6379