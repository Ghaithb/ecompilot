    "seed:test": "ts-node src/scripts/create-test-account.ts",
    "migrate:prisma": "ts-node -r tsconfig-paths/register scripts/migrate-data-to-prisma.ts",
    "prisma:rls": "prisma db execute --file prisma/sql/enable-rls.sql"
